#!/usr/bin/env bash
#
# 
# Batch video encoder for X265/HEVC conversion
# 
# Author: Rish
# Date: June 9, 2026
# License: MIT
# 
#
# Colors
YW='\e[1;33m'   # yellow
GN='\e[1;32m'   # green
RD='\e[1;31m'   # red
GY='\e[1;30m'   # gray
WE='\e[1;37m'   # white
NC='\e[0m'      # normal

usage() {
    echo -e "Usage: vx265 [OPTION] <ARGUMENT>"
    echo -e "Options:"
    echo -e "  --mkv          Converts all .mkv files"
    echo -e "  --mp4          Converts all .mp4 files"
    echo -e "  --m4v          Converts all .m4v files"
    echo -e "  --mp4 21       Pass a crf value (Default: 28)"
    echo -e "  -h, --help     Display this help message"
}

(($# < 1)) && { usage; exit 1; }

chk_dpdc() {
    if ! command -v ffmpeg &> /dev/null; then 
        echo -e "${RD}> Install ffmpeg first${NC}"
        echo "> Run: pkg install ffmpeg"; exit 1
    fi
}

main() {
    local format="$1"
    echo -e "${WE}Converting '${format^^}s' into x265 codec...\n${NC}"

    for file in *.${format}; do
        [[ -e "$file" ]] || { echo "No '${format^^}' files found."; return; }
        echo -e "${GY} Processing '$file'...${NC}"
        ffmpeg -hide_banner -loglevel error -i "$file" -c:a copy -c:v libx265 -crf "${CRF:-28}" "${file%.*}_new.${format}"
        sleep 5
    done

    printf "\n${GN}Completed, time elapsed: ${NC}%02dh %02dm %02ds\n" $((SECONDS/3600)) $(((SECONDS/60)%60)) $((SECONDS%60))
}

chk_dpdc 

EXT="$1"
CRF="$2"

case $EXT in
    --mkv ) main "mkv" ;; 
    --mp4 ) main "mp4" ;;
    --m4v ) main "m4v" ;; 
    --help | -h ) usage ;;
    *) echo -e "${RD}Invalid option:${NC} '${YW}$EXT${NC}'"
       echo -e "Try 'vx265 --help' for more information."
       exit 1 ;;
esac
