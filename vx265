#!/usr/bin/env bash
#
# ---------------------------------------------------------
# Batch video encoder for X265/HEVC conversion
# ---------------------------------------------------------
# Author:      Rish
# Date:        May 3, 2026
# License:     MIT
# ---------------------------------------------------------
#
# Colors
YELLOW='\e[1;33m'
GREEN='\e[1;32m'
RED='\e[1;31m'
WHITE='\e[1;37m'
RESET='\e[0m'

usage() {
    echo -e "Usage: vx265 [path/to/video directory] [Options]"
    echo -e "Options:"
    echo -e "  --mkv          Converts all .mkv files"
    echo -e "  --mp4          Converts all .mp4 files"
    echo -e "  --m4v          Converts all .m4v files"
    echo -e "  -h, --help     Display this help message"
}

# Check if at least two arguments are provided
(($# < 2)) && { usage; exit 1; }

chk_dpdc() {
    if ! command -v ffmpeg > /dev/null 2>&1; then 
        echo -e "${RED}> Please install ffmpeg first${RESET}"
        echo "> Run: pkg install ffmpeg"; exit 1
    fi
}

main() {
    local format="$1"
    echo -e "${WHITE}Converting '${format^^}s' into x265 codec...${RESET}"
    for file in "$VID_DIR"/*.${format}; do
        [[ -e "$file" ]] || { echo "No '${format^^}' files found."; return; }
        echo -e "${YELLOW} Processing '$file'...${RESET}"
        ffmpeg -hide_banner -loglevel error -i "$file" -c:v libx265 "${file%.*}_new.${format}"
        sleep 3
    done
    echo -e "\n${GREEN}Encoding completed successfully!${RESET}"
}

chk_dpdc 

VID_DIR="$1"
EXTENSION="$2"

if [[ ! -d "$VID_DIR" ]]; then
    echo -e "${RED}Error:${RESET} Directory '$VID_DIR' not found."
    exit 1
fi

case $EXTENSION in
    --mkv ) main "mkv" ;; 
    --mp4 ) main "mp4" ;;
    --m4v ) main "m4v" ;; 
    --help | -h ) usage ;;
    *) echo -e "${RED}Invalid option:${RESET} '${YELLOW}$EXTENSION${RESET}'"
       echo -e "Try 'vx265 --help' for more information."
       exit 1 ;;
esac
